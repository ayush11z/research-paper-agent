# Live mode: speech-to-text (https://console.deepgram.com)
DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3

# Paper sources
OPENALEX_API_KEY=        # free at https://openalex.org/settings/api (required by OpenAlex since Feb 2026)
S2_API_KEY=              # optional, https://www.semanticscholar.org/product/api (keyless is usually rate-limited)
CONTACT_EMAIL=           # used for Crossref/Unpaywall polite pool; Unpaywall PDF links are skipped without it

# Models
# OLLAMA_MODEL=qwen3:4b-instruct          # deep search LLM
# LIVE_LLM=qwen3:4b-instruct              # live query writer
# EMBED_MODEL=BAAI/bge-small-en-v1.5      # or Qwen/Qwen3-Embedding-0.6B (better, ~25x slower)
# KEYPHRASE_MODEL=ml6team/keyphrase-extraction-distilbert-inspec
# MIN_RELEVANCE=0.6
GEMINI_API_KEY=          # optional, figure/table analysis in deep search
# GEMINI_MODEL=gemini-3.8-flash
# PORT=3000
